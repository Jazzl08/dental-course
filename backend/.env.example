# =============================================================================
# DENTAL COURSE PLATFORM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values
# NEVER commit .env to git
#
# PRODUCTIE (Render + Vercel):
#   NODE_ENV=production
#   CLIENT_URL=https://jouw-app.vercel.app   (of eigen domein)
#   CORS_ORIGINS=https://jouw-app.vercel.app
#   COOKIE_SAMESITE=none   (verplicht voor cross-domain cookies!)
#   MOLLIE_REDIRECT_URL=https://jouw-app.vercel.app/checkout/succes
#   MOLLIE_WEBHOOK_URL=https://jouw-api.onrender.com/api/payments/webhook
# =============================================================================

# Server
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (Neon)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_64_char_random_access_secret_here
JWT_REFRESH_SECRET=your_64_char_random_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mollie (https://my.mollie.com/dashboard/developers/api-keys)
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook
MOLLIE_REDIRECT_URL=https://yourdomain.com/checkout/success

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@uwdomein.nl
RESEND_FROM_NAME=MondhygiëneCursus
SUPPORT_EMAIL=support@uwdomein.nl
BRAND_NAME=MondhygieneCursus

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Cookies
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# Token lifetimes
EMAIL_VERIFY_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=2h
